<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">

  <!--
    config.jelly – Displayed in the job configuration page under "This project is parameterized"
    when the user adds a "Hot Reload Parameters" parameter definition.
  -->

  <f:entry title="${%repoUrl.title}" field="repoUrl" description="${%repoUrl.description}">
    <f:textbox/>
  </f:entry>

  <f:entry title="${%credentialsId.title}" field="credentialsId" description="${%credentialsId.description}">
    <f:textbox/>
  </f:entry>

  <f:entry title="${%paramFilePath.title}" field="paramFilePath" description="${%paramFilePath.description}">
    <f:textbox default="vars/release-pipeline.groovy"/>
  </f:entry>

  <f:entry title="${%triggerParamName.title}" field="triggerParamName" description="${%triggerParamName.description}">
    <f:textbox default="RELEASE_BRANCH"/>
  </f:entry>

  <f:entry title="${%defaultBranch.title}" field="defaultBranch" description="${%defaultBranch.description}">
    <f:textbox default="master"/>
  </f:entry>

</j:jelly>
